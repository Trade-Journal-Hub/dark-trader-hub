rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // ENHANCED SECURITY FUNCTIONS WITH APP CHECK
    // ============================================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if request has valid App Check token (production)
    function hasValidAppCheck() {
      // In production, require App Check token
      // In development, allow requests without App Check for testing
      return request.auth.token.firebase.app_check == true || 
             request.auth.token.firebase.app_check_debug == true;
    }
    
    // Enhanced authentication check with App Check
    function isAuthenticatedWithAppCheck() {
      return isAuthenticated() && hasValidAppCheck();
    }
    
    // Check if user is admin (optional for future use)
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Validate user data structure
    function isValidUserData() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) &&
             data.email is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }
    
    // Validate trade data structure
    function isValidTradeData() {
      let data = request.resource.data;
      return data.keys().hasAll(['symbol', 'side', 'quantity', 'price', 'date', 'userId']) &&
             data.symbol is string &&
             data.side in ['BUY', 'SELL'] &&
             data.quantity is number &&
             data.price is number &&
             data.date is timestamp &&
             data.userId == request.auth.uid;
    }
    
    // Enhanced rate limiting with App Check consideration
    function isWithinRateLimit() {
      // More permissive rate limits for App Check verified requests
      return hasValidAppCheck() || 
             resource == null || 
             request.time > resource.data.lastAccess + duration.value(1, 's');
    }
    
    // ============================================================================
    // USER MANAGEMENT WITH APP CHECK
    // ============================================================================
    
    // User profiles - enhanced security with App Check
    match /users/{userId} {
      allow read: if isAuthenticatedWithAppCheck() && isOwner(userId);
      allow create: if isAuthenticatedWithAppCheck() && isOwner(userId) && isValidUserData();
      allow update: if isAuthenticatedWithAppCheck() && isOwner(userId) && isValidUserData();
      allow delete: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // User settings - App Check protected
    match /userSettings/{userId} {
      allow read, write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // ============================================================================
    // TRADING DATA WITH APP CHECK PROTECTION
    // ============================================================================
    
    // Trading data - critical data requires App Check
    match /trades/{tradeId} {
      allow read: if isAuthenticatedWithAppCheck() && 
                     resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticatedWithAppCheck() && 
                       isValidTradeData() &&
                       isWithinRateLimit();
      
      allow update: if isAuthenticatedWithAppCheck() && 
                       resource.data.userId == request.auth.uid &&
                       isValidTradeData();
      
      allow delete: if isAuthenticatedWithAppCheck() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // User's trade collections
    match /users/{userId}/trades/{tradeId} {
      allow read, write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // ============================================================================
    // ANALYTICS DATA WITH APP CHECK
    // ============================================================================
    
    // Analytics data - sensitive financial data requires App Check
    match /analytics/{userId} {
      allow read: if isAuthenticatedWithAppCheck() && isOwner(userId);
      allow write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // Cached analytics data
    match /analyticsCache/{userId} {
      allow read: if isAuthenticatedWithAppCheck() && isOwner(userId);
      allow write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // Performance metrics
    match /performanceMetrics/{userId} {
      allow read, write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // ============================================================================
    // FILE METADATA WITH APP CHECK
    // ============================================================================
    
    // File upload metadata - requires App Check for upload operations
    match /fileUploads/{userId}/files/{fileId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // Processing status
    match /processingStatus/{userId}/files/{fileId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // ============================================================================
    // SUBSCRIPTION DATA (BACKEND ONLY)
    // ============================================================================
    
    // User subscriptions - backend service account only
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false; // Backend service account only
    }
    
    // Usage tracking - App Check required for writes
    match /usageTracking/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticatedWithAppCheck() && isOwner(userId);
    }
    
    // ============================================================================
    // ADMIN COLLECTIONS
    // ============================================================================
    
    // Admin users list - enhanced security
    match /admins/{userId} {
      allow read: if isAdmin() && hasValidAppCheck();
      allow write: if false; // Manual admin assignment only
    }
    
    // System logs - admin only with App Check
    match /systemLogs/{logId} {
      allow read: if isAdmin() && hasValidAppCheck();
      allow write: if false; // Backend only
    }
    
    // ============================================================================
    // PUBLIC DATA (LIMITED ACCESS)
    // ============================================================================
    
    // App configuration - public read-only (but logged)
    match /config/app {
      allow read: if true; // Public but monitored
      allow write: if false; // Admin console only
    }
    
    // Market data - public read with App Check preferred
    match /marketData/{symbol} {
      allow read: if true; // Public access for market data
      allow write: if false; // Backend service only
    }
    
    // ============================================================================
    // APP CHECK MONITORING
    // ============================================================================
    
    // App Check verification logs (for monitoring)
    match /appCheckLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // System generated only
    }
    
    // Security incidents (failed App Check verifications)
    match /securityIncidents/{incidentId} {
      allow read: if isAdmin();
      allow write: if false; // System generated only
    }
    
    // ============================================================================
    // SECURITY DEFAULTS WITH APP CHECK
    // ============================================================================
    
    // Default deny rule - everything not explicitly allowed is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

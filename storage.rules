rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================================
    // SECURITY FUNCTIONS
    // ============================================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check file size limits
    function isValidFileSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }
    
    // Check if file type is allowed for trading data
    function isValidTradingFileType() {
      return request.resource.contentType.matches('text/csv') ||
             request.resource.contentType.matches('application/vnd.ms-excel') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet') ||
             request.resource.contentType.matches('application/csv');
    }
    
    // Check if file type is allowed for profile images
    function isValidImageType() {
      return request.resource.contentType.matches('image/jpeg') ||
             request.resource.contentType.matches('image/png') ||
             request.resource.contentType.matches('image/webp');
    }
    
    // Check rate limiting (basic protection)
    function isWithinUploadLimit() {
      // Basic rate limiting - can be enhanced with Firestore counters
      return request.resource.size > 0;
    }
    
    // Validate filename doesn't contain malicious patterns
    function isSafeFilename(filename) {
      return !filename.matches('.*\\.\\..*') && // No path traversal
             !filename.matches('.*[<>:"|?*].*') && // No invalid chars
             filename.size() <= 255; // Reasonable length
    }
    
    // ============================================================================
    // TRADING FILES
    // ============================================================================
    
    // Trading data files - users can only upload to their own directory
    match /trading-files/{userId}/{fileName} {
      // Allow read access to own files
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Allow upload of valid trading files
      allow write: if isAuthenticated() && 
                      isOwner(userId) &&
                      isValidFileSize() &&
                      isValidTradingFileType() &&
                      isWithinUploadLimit() &&
                      isSafeFilename(fileName);
      
      // Allow deletion of own files
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Processed trading files (generated by backend)
    match /processed-files/{userId}/{fileName} {
      // Users can read their processed files
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Only backend can write processed files
      allow write: if false; // Backend service account only
      
      // Users can delete their processed files
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================================================
    // USER PROFILE DATA
    // ============================================================================
    
    // Profile pictures
    match /profile-images/{userId}/{fileName} {
      allow read: if isAuthenticated() && isOwner(userId);
      
      allow write: if isAuthenticated() && 
                      isOwner(userId) &&
                      isValidImageType() &&
                      request.resource.size <= 2 * 1024 * 1024 && // 2MB for images
                      isSafeFilename(fileName);
      
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================================================
    // TEMPORARY FILES
    // ============================================================================
    
    // Temporary upload files (auto-cleanup after processing)
    match /temp-uploads/{userId}/{fileName} {
      // Short-lived temporary files for processing
      allow read, write: if isAuthenticated() && 
                            isOwner(userId) &&
                            isValidFileSize() &&
                            isValidTradingFileType() &&
                            isSafeFilename(fileName);
      
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================================================
    // EXPORT FILES
    // ============================================================================
    
    // Analytics export files (generated reports)
    match /exports/{userId}/{fileName} {
      // Users can read their export files
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Only backend can create export files
      allow write: if false; // Backend service account only
      
      // Users can delete their export files
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================================================
    // BACKUP FILES
    // ============================================================================
    
    // User data backups
    match /backups/{userId}/{fileName} {
      // Users can read their backups
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Only backend can create backups
      allow write: if false; // Backend service account only
      
      // Users can delete their backups
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================================================
    // PUBLIC ASSETS
    // ============================================================================
    
    // Public app assets (logos, etc.) - read-only
    match /public/{fileName} {
      allow read: if true;
      allow write: if false; // Admin only
    }
    
    // ============================================================================
    // ADMIN FILES
    // ============================================================================
    
    // Admin uploads (system files, etc.)
    match /admin/{fileName} {
      // Only authenticated users can read admin files
      allow read: if isAuthenticated();
      
      // No direct uploads to admin directory
      allow write: if false; // Admin console only
    }
    
    // ============================================================================
    // SECURITY DEFAULTS
    // ============================================================================
    
    // Block access to service account keys and sensitive files
    match /credentials/{fileName} {
      allow read, write: if false; // Never allow access
    }
    
    match /secrets/{fileName} {
      allow read, write: if false; // Never allow access
    }
    
    match /{allPaths=**} {
      // Block any file with sensitive extensions
      allow read, write: if !resource.name.matches('.*\\.(key|pem|p12|json|env)$');
    }
    
    // Default deny rule - anything not explicitly allowed is denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}